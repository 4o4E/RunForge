RUNFORGE_IMAGE=ghcr.io/4o4e/runforge:v0.1.0
RUNFORGE_PORT=8080

# 自带 PostgreSQL 的 Compose 使用下面三个值。密码使用字母、数字和 URL 安全符号。
POSTGRES_USER=runforge
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_DB=runforge

# 外部 PostgreSQL 版本使用该连接串。
DATABASE_URL=postgresql://runforge:replace-with-a-long-url-safe-password@database.example.com:5432/runforge

RUNFORGE_JWT_SECRET=replace-with-at-least-32-random-characters
RUNFORGE_SHARE_SECRET=replace-with-another-long-random-secret
RUNFORGE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
RUNFORGE_BOOTSTRAP_SYSADMIN_PASSWORD=replace-with-a-strong-system-admin-password

LLM_PROVIDER=aisdk
LLM_AISDK_FLAVOR=openai-compatible
LLM_REASONING_TAG=think
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2
LLM_STREAM=true

AGENT_HARD_STEP_CAP=1000
TOOL_SANDBOX=off
TOOL_SANDBOX_BACKEND=auto
TOOL_NETWORK=disabled
TOOL_MAX_OUTPUT=40000

# OFFICE_PREVIEW_CONVERTER_URL=http://office-converter:3000
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
