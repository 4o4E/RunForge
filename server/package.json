{
  "name": "server",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "predev": "pnpm --filter @runforge/workload-sdk build && pnpm prisma:generate",
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm --filter @runforge/workload-sdk build && pnpm prisma:generate",
    "build": "pnpm run build:compile",
    "build:compile": "tsc -p tsconfig.json && cp src/llm/model-catalog.json dist/llm/model-catalog.json",
    "model-catalog:update": "tsx src/llm/updateModelCatalog.ts",
    "model-catalog:check": "tsx src/llm/updateModelCatalog.ts --check",
    "migrate:legacy-plugin-links": "tsx src/maintenance/migrateLegacyPluginLinks.ts",
    "clean:legacy-thread-workspaces": "tsx src/maintenance/cleanLegacyThreadWorkspaces.ts",
    "sanitize:provider-traces": "tsx src/maintenance/sanitizeProviderTraces.ts",
    "start": "node dist/index.js",
    "pretest": "pnpm --filter @runforge/workload-sdk build && pnpm prisma:generate",
    "test": "STORE=memory node --import tsx --test src/id.test.ts src/settings.test.ts src/api/auth.test.ts src/api/files.test.ts src/api/files.pathSecurity.test.ts src/api/usage.test.ts src/files/threadWorkspace.test.ts src/files/workspace.test.ts src/web/static.test.ts src/tools/tools.test.ts src/tools/fileRead.media.test.ts src/tools/policy.test.ts src/tools/fileSearch.pathSecurity.test.ts src/tools/sandbox.test.ts src/skills/registry.test.ts src/usage/service.test.ts src/datasources/accountPool.test.ts src/mcp/client.test.ts src/llm/aiSdk.test.ts src/llm/providerRunner.test.ts src/llm/attachments.test.ts src/llm/probe.test.ts src/workflows/registry.test.ts src/businessPlugins/registry.test.ts src/plugins/runtime.test.ts src/spaces/config.test.ts src/spaces/materialize.test.ts src/spaces/access.test.ts src/external/service.test.ts src/agent/executor.test.ts src/agent/compaction.test.ts src/agent/persistence.test.ts src/agent/goal.test.ts src/auth/bootstrap.test.ts src/api/authRoutes.test.ts src/api/businessPluginImport.test.ts src/api/tenants.test.ts src/api/spaces.test.ts src/api/system.test.ts",
    "preverify:agent-core": "pnpm --filter @runforge/workload-sdk build && pnpm prisma:generate",
    "verify:agent-core": "tsx src/evals/agentCoreVerification.ts",
    "preverify:prisma-store": "pnpm --filter @runforge/workload-sdk build && pnpm prisma:generate",
    "verify:prisma-store": "tsx src/evals/prismaStoreVerification.ts",
    "preverify:space-runtime": "pnpm --filter @runforge/workload-sdk build && pnpm prisma:generate",
    "verify:space-runtime": "tsx src/evals/spaceRuntimeVerification.ts",
    "pretypecheck": "pnpm prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:baseline": "prisma migrate resolve --applied 20260916000000_baseline",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.82",
    "@ai-sdk/openai": "^3.0.69",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@langchain/core": "^1.2.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^1.0.9",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@runforge/contracts": "workspace:*",
    "@runforge/workload-sdk": "workspace:*",
    "ai": "^6.0.200",
    "ajv": "^8.20.0",
    "busboy": "^1.6.0",
    "cordis": "4.0.0-rc.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "file-type": "^22.1.1",
    "jsonwebtoken": "^9.0.3",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.13.1",
    "prisma": "7.10.0",
    "sharp": "^0.35.4",
    "tar": "^7.5.22",
    "undici": "^7.29.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "yazl": "^3.3.1"
  }
}
