generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "esm"
}

datasource db {
  provider = "postgresql"
}

model app_settings {
  key        String
  value      Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  tenant_id  String   @default("default")
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([tenant_id, key])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auth_tokens {
  id         String    @id
  tenant_id  String
  user_id    String
  kind       String
  token_hash String    @unique
  label      String?
  expires_at DateTime? @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  tenants    tenants   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, kind, revoked_at], map: "idx_auth_tokens_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model datasource_account_leases {
  id                             String                         @id
  account_id                     String
  datasource_id                  String
  profile_id                     String
  run_id                         String
  token_id                       String?
  status                         String                         @default("leased")
  leased_at                      DateTime                       @default(now()) @db.Timestamptz(6)
  expires_at                     DateTime                       @db.Timestamptz(6)
  released_at                    DateTime?                      @db.Timestamptz(6)
  error                          String?
  created_at                     DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                       @default(now()) @db.Timestamptz(6)
  datasource_accounts            datasource_accounts            @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  datasources                    datasources                    @relation(fields: [datasource_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  datasource_permission_profiles datasource_permission_profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  runs                           runs                           @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workload_tokens                workload_tokens?               @relation(fields: [token_id], references: [id], onUpdate: NoAction)

  @@index([status, expires_at], map: "idx_datasource_leases_expiry")
  @@index([run_id, status], map: "idx_datasource_leases_run")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model datasource_accounts {
  id                             String                         @id
  datasource_id                  String
  profile_id                     String
  username                       String
  status                         String                         @default("idle")
  current_run_id                 String?
  leased_until                   DateTime?                      @db.Timestamptz(6)
  last_lease_at                  DateTime?                      @db.Timestamptz(6)
  last_rotated_at                DateTime?                      @db.Timestamptz(6)
  failure_count                  Int                            @default(0)
  metadata                       Json                           @default("{}")
  created_at                     DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                       @default(now()) @db.Timestamptz(6)
  datasource_account_leases      datasource_account_leases[]
  runs                           runs?                          @relation(fields: [current_run_id], references: [id], onUpdate: NoAction)
  datasources                    datasources                    @relation(fields: [datasource_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  datasource_permission_profiles datasource_permission_profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([datasource_id, username])
  @@index([datasource_id, profile_id, status], map: "idx_datasource_accounts_pool")
  @@index([current_run_id], map: "idx_datasource_accounts_run")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model datasource_permission_profiles {
  id                        String                      @id
  datasource_id             String
  name                      String
  mode                      String                      @default("readonly")
  template_role             String?
  grants                    Json                        @default("{}")
  pool_config               Json                        @default("{}")
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  datasource_account_leases datasource_account_leases[]
  datasource_accounts       datasource_accounts[]
  datasources               datasources                 @relation(fields: [datasource_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([datasource_id, name])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model datasources {
  id                             String                           @id
  name                           String
  type                           String
  status                         String                           @default("active")
  connection                     Json                             @default("{}")
  admin_config                   Json                             @default("{}")
  pool_config                    Json                             @default("{}")
  created_at                     DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                         @default(now()) @db.Timestamptz(6)
  enabled                        Boolean                          @default(true)
  tenant_id                      String                           @default("default")
  datasource_account_leases      datasource_account_leases[]
  datasource_accounts            datasource_accounts[]
  datasource_permission_profiles datasource_permission_profiles[]
  tenants                        tenants                          @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, name], map: "idx_datasources_name_tenant")
}

model events {
  id         BigInt   @id @default(autoincrement())
  run_id     String
  step_id    String?
  idx        Int      @default(0)
  type       String
  data       Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  runs       runs     @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  steps      steps?   @relation(fields: [step_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([run_id, id], map: "idx_events_run")
}

model external_callers {
  id                String              @id
  tenant_id         String
  space_id          String
  name              String
  status            String              @default("active")
  metadata          Json                @default("{}")
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  artifacts         artifacts[]
  external_requests external_requests[]
  external_tokens   external_tokens[]
  run_inputs        run_inputs[]
  spaces            spaces              @relation(fields: [space_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: NoAction)
  tenants           tenants             @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  threads           threads[]

  @@index([space_id, status], map: "idx_external_callers_space")
  @@index([tenant_id, status], map: "idx_external_callers_tenant")
}

model external_requests {
  id                  String           @id
  caller_id           String
  operation           String
  idempotency_key     String
  request_hash        String
  status              String           @default("processing")
  response            Json?
  external_thread_ref String?
  external_event_id   String?
  source_ref          Json             @default("{}")
  thread_id           String?
  run_id              String?
  error               String?
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @default(now()) @db.Timestamptz(6)
  external_callers    external_callers @relation(fields: [caller_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  runs                runs?            @relation(fields: [run_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  threads             threads?         @relation(fields: [thread_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  run_inputs          run_inputs[]

  @@unique([caller_id, operation, idempotency_key], map: "uq_external_requests_idempotency")
  @@unique([caller_id, external_thread_ref], map: "uq_external_requests_thread_ref")
  @@unique([caller_id, external_event_id], map: "uq_external_requests_event_id")
  @@index([run_id, created_at], map: "idx_external_requests_run")
  @@index([thread_id, created_at], map: "idx_external_requests_thread")
}

model external_tokens {
  id               String           @id
  caller_id        String
  token_hash       String           @unique
  label            String?
  expires_at       DateTime?        @db.Timestamptz(6)
  revoked_at       DateTime?        @db.Timestamptz(6)
  last_used_at     DateTime?        @db.Timestamptz(6)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  external_callers external_callers @relation(fields: [caller_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([caller_id, revoked_at, expires_at], map: "idx_external_tokens_caller")
}

model messages {
  id             BigInt   @id @default(autoincrement())
  thread_id      String
  run_id         String
  step_id        String?
  role           String
  content        String?
  tool_calls     Json?
  tool_call_id   String?
  collapsed      String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  summary_of     BigInt[]
  provider_state Json?
  runs           runs     @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  steps          steps?   @relation(fields: [step_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  threads        threads  @relation(fields: [thread_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([run_id, id], map: "idx_messages_run")
  @@index([thread_id, id], map: "idx_messages_thread")
}

model push_subscriptions {
  endpoint        String    @id
  p256dh          String
  auth            String
  expiration_time DateTime? @db.Timestamptz(6)
  user_agent      String?
  enabled         Boolean   @default(true)
  last_error      String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  tenant_id       String    @default("default")
  user_id         String?
  tenants         tenants   @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([enabled, updated_at(sort: Desc)], map: "idx_push_subscriptions_enabled")
  @@index([tenant_id, user_id, enabled], map: "idx_push_subscriptions_tenant_user")
}

model runs {
  id                                     String                        @id
  thread_id                              String
  status                                 String                        @default("pending")
  input                                  String
  output                                 String?
  error                                  String?
  goal_state                             Json?
  created_at                             DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                             DateTime                      @default(now()) @db.Timestamptz(6)
  model_ref                              String?
  parent_run_id                          String?
  runtime_capabilities_snapshot          Json?
  space_config_snapshot                  Json?
  space_config_version                   Int?
  plugin_lock                            Json?
  external_input_open                    Boolean                       @default(false)
  input_version                          Int                           @default(0)
  external_requests                      external_requests[]
  provider_invocations                   provider_invocations[]
  run_inputs                             run_inputs[]
  artifacts                              artifacts[]
  datasource_account_leases              datasource_account_leases[]
  workload_secret_access_logs            workload_secret_access_logs[]
  datasource_accounts                    datasource_accounts[]
  events                                 events[]
  messages                               messages[]
  runs                                   runs?                         @relation("runsToruns", fields: [parent_run_id], references: [id], onUpdate: NoAction)
  other_runs                             runs[]                        @relation("runsToruns")
  threads_runs_thread_idTothreads        threads                       @relation("runs_thread_idTothreads", fields: [thread_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  runtime_capability_calls               runtime_capability_calls[]
  shell_commands                         shell_commands[]
  shell_sessions                         shell_sessions[]
  steps                                  steps[]
  subagent_runs                          subagent_runs[]
  thread_notices                         thread_notices[]
  threads_threads_active_run_idToruns    threads[]                     @relation("threads_active_run_idToruns")
  threads_threads_executing_run_idToruns threads[]                     @relation("threads_executing_run_idToruns")
  workload_tokens                        workload_tokens[]

  @@unique([id, thread_id])
  @@index([thread_id, created_at], map: "idx_runs_thread")
  @@index([thread_id, parent_run_id, created_at], map: "idx_runs_thread_parent")
}

model run_inputs {
  id                  String            @id
  run_id              String
  caller_id           String
  external_request_id String
  version             Int
  content             String
  artifacts           Json              @default("[]")
  status              String            @default("pending")
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  applied_at          DateTime?         @db.Timestamptz(6)
  canceled_at         DateTime?         @db.Timestamptz(6)
  external_callers    external_callers  @relation(fields: [caller_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  external_requests   external_requests @relation(fields: [external_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  runs                runs              @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([external_request_id])
  @@unique([run_id, version])
  @@index([run_id, status, version], map: "idx_run_inputs_pending")
}

model artifacts {
  id               String           @id
  caller_id        String
  space_id         String
  thread_id        String?
  run_id           String?
  storage_key      String           @unique
  original_name    String
  mime_type        String
  size_bytes       BigInt
  status           String           @default("staged")
  metadata         Json             @default("{}")
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  materialized_at  DateTime?        @db.Timestamptz(6)
  external_callers external_callers @relation(fields: [caller_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  runs             runs?            @relation(fields: [run_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  spaces           spaces           @relation(fields: [space_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  threads          threads?         @relation(fields: [thread_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([caller_id, status, created_at], map: "idx_artifacts_caller")
  @@index([space_id, thread_id, run_id], map: "idx_artifacts_scope")
}

model provider_invocations {
  id                  String              @id
  tenant_id           String
  space_id            String
  thread_id           String
  run_id              String
  step_id             String?
  purpose             String
  provider            String
  model               String
  logical_request     Json
  normalized_response Json?
  status              String              @default("running")
  error               String?
  started_at          DateTime            @default(now()) @db.Timestamptz(6)
  ended_at            DateTime?           @db.Timestamptz(6)
  provider_attempts   provider_attempts[]
  runs                runs                @relation(fields: [run_id, thread_id], references: [id, thread_id], onDelete: Cascade, onUpdate: NoAction)
  spaces              spaces              @relation(fields: [space_id, tenant_id], references: [id, tenant_id], onDelete: NoAction, onUpdate: NoAction)
  steps               steps?              @relation(fields: [step_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  threads             threads             @relation(fields: [thread_id, space_id, tenant_id], references: [id, space_id, tenant_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([run_id, started_at], map: "idx_provider_invocations_run")
  @@index([tenant_id, space_id, started_at], map: "idx_provider_invocations_space")
}

model provider_attempts {
  id                   String               @id
  invocation_id        String
  attempt              Int
  url                  String
  request_body         Json
  http_status          Int?
  provider_response_id String?
  raw_stream           String?
  normalized_response  Json?
  finish_reason        String?
  usage                Json?
  status               String               @default("running")
  error_kind           String?
  error                String?
  started_at           DateTime             @default(now()) @db.Timestamptz(6)
  ended_at             DateTime?            @db.Timestamptz(6)
  provider_invocations provider_invocations @relation(fields: [invocation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([invocation_id, attempt])
  @@index([provider_response_id], map: "idx_provider_attempts_response_id")
}

model spaces {
  id                   String                 @id
  tenant_id            String
  mode                 String
  name                 String
  execution_user_id    String?
  config               Json                   @default("{}")
  config_version       Int                    @default(1)
  created_by_user_id   String?
  deleted_at           DateTime?              @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  artifacts            artifacts[]
  external_callers     external_callers[]
  provider_invocations provider_invocations[]
  space_visible_users  space_visible_users[]
  tenants              tenants                @relation("spaces_tenant", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  default_for_tenants  tenants[]              @relation("tenants_default_space")
  execution_user       users?                 @relation("spaces_execution_user", fields: [execution_user_id, tenant_id], references: [id, tenant_id], onDelete: NoAction, onUpdate: NoAction)
  created_by_user      users?                 @relation("spaces_created_by", fields: [created_by_user_id, tenant_id], references: [id, tenant_id], onDelete: NoAction, onUpdate: NoAction)
  threads              threads[]

  @@unique([id, tenant_id])
  @@index([tenant_id, deleted_at, created_at], map: "idx_spaces_tenant")
  @@index([execution_user_id], map: "idx_spaces_execution_user")
}

model space_visible_users {
  space_id   String
  user_id    String
  tenant_id  String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  spaces     spaces   @relation(fields: [space_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([space_id, user_id])
  @@index([user_id, space_id], map: "idx_space_visible_users_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model runtime_capability_calls {
  id               String           @id
  tenant_id        String
  run_id           String
  step_id          String?
  token_id         String?
  capability       String
  provider         String?
  model            String?
  request_summary  Json             @default("{}")
  response_summary Json             @default("{}")
  usage            Json?
  status           String
  error            String?
  started_at       DateTime         @default(now()) @db.Timestamptz(6)
  ended_at         DateTime         @default(now()) @db.Timestamptz(6)
  runs             runs             @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  steps            steps?           @relation(fields: [step_id], references: [id], onUpdate: NoAction)
  tenants          tenants          @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workload_tokens  workload_tokens? @relation(fields: [token_id], references: [id], onUpdate: NoAction)

  @@index([run_id, started_at(sort: Desc)], map: "idx_runtime_capability_calls_run")
  @@index([tenant_id, started_at(sort: Desc)], map: "idx_runtime_capability_calls_tenant")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shell_command_logs {
  id             BigInt         @id @default(autoincrement())
  command_id     String
  seq            BigInt
  stream         String
  chunk          String
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  shell_commands shell_commands @relation(fields: [command_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([command_id, seq])
  @@index([command_id, seq], map: "idx_shell_command_logs_command")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shell_commands {
  id                 String               @id
  session_id         String               @unique(map: "idx_shell_commands_one_running_per_session", where: raw("(status = ANY (ARRAY['queued'::text, 'running'::text]))"))
  run_id             String?
  step_id            String?
  actor              String               @default("agent")
  command            String
  cwd                String
  wait_mode          String               @default("foreground")
  status             String               @default("queued")
  attention          String?
  host_pid           Int?
  child_pid          Int?
  exit_code          Int?
  signal             String?
  soft_timeout_ms    Int?
  hard_timeout_ms    Int?
  soft_timeout_at    DateTime?            @db.Timestamptz(6)
  hard_timeout_at    DateTime?            @db.Timestamptz(6)
  last_output_at     DateTime?            @db.Timestamptz(6)
  output_bytes       BigInt               @default(0)
  error              String?
  started_at         DateTime             @default(now()) @db.Timestamptz(6)
  ended_at           DateTime?            @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  shell_command_logs shell_command_logs[]
  runs               runs?                @relation(fields: [run_id], references: [id], onUpdate: NoAction)
  shell_sessions     shell_sessions       @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  steps              steps?               @relation(fields: [step_id], references: [id], onUpdate: NoAction)

  @@index([run_id, status], map: "idx_shell_commands_run")
  @@index([session_id, started_at], map: "idx_shell_commands_session")
  @@index([status, updated_at], map: "idx_shell_commands_status")
}

model shell_session_events {
  id             BigInt         @id @default(autoincrement())
  session_id     String
  actor          String
  kind           String
  data           Json           @default("{}")
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  shell_sessions shell_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id, id], map: "idx_shell_session_events_session")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shell_sessions {
  id                   String                 @id
  thread_id            String
  workspace_root       String
  backend              String
  status               String                 @default("idle")
  lease_actor          String?
  lease_run_id         String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  cwd                  String
  name                 String                 @default("Default")
  owner                String                 @default("agent")
  config_snapshot      Json?
  deleted_at           DateTime?              @db.Timestamptz(6)
  tenant_id            String                 @default("default")
  shell_commands       shell_commands?
  shell_session_events shell_session_events[]
  runs                 runs?                  @relation(fields: [lease_run_id], references: [id], onUpdate: NoAction)
  tenants              tenants                @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  threads              threads                @relation(fields: [thread_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([thread_id, workspace_root, deleted_at], map: "idx_shell_sessions_active")
  @@index([tenant_id], map: "idx_shell_sessions_tenant")
  @@index([thread_id, workspace_root, status], map: "idx_shell_sessions_thread")
}

model steps {
  id                          String                        @id
  run_id                      String
  idx                         Int
  created_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  events                      events[]
  messages                    messages[]
  runtime_capability_calls    runtime_capability_calls[]
