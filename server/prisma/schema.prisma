  @@index([run_id], map: "idx_workload_tokens_run")
}

/// Secret 访问审计只保存读取上下文和结果，绝不保存 Secret 值。
model workload_secret_access_logs {
  id              String          @id
  tenant_id       String
  run_id          String
  step_id         String?
  token_id        String
  accessor        String
  secret_key      String
  status          String
  error_code      String?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  tenants         tenants         @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  runs            runs            @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  steps           steps?          @relation(fields: [step_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  workload_tokens workload_tokens @relation(fields: [token_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id, created_at(sort: Desc)], map: "idx_workload_secret_access_tenant")
  @@index([run_id, created_at(sort: Desc)], map: "idx_workload_secret_access_run")
  @@index([secret_key, created_at(sort: Desc)], map: "idx_workload_secret_access_key")
}
