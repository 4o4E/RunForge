# ---- Server ----
# 开发环境绑定 IPv6 任意地址,适配浏览器/SSH 把 localhost 解析到 ::1 的情况。
# 常见 Linux 双栈 socket 下也会同时接受 IPv4。
HOST=::
PORT=8080

# ---- Access control (多租户/JWT 改造，docs/multi-tenancy-design.md §4) ----
# JWT 签名密钥(HS256)，必填——服务启动时会校验，缺失直接报错退出。
RUNFORGE_JWT_SECRET=replace-with-a-long-random-secret
# access token 有效期(秒)，默认 45 分钟；refresh token 有效期(秒)，默认 30 天。
# RUNFORGE_ACCESS_TOKEN_TTL_SECONDS=2700
# RUNFORGE_REFRESH_TOKEN_TTL_SECONDS=2592000

# 老部署兼容路径:启动时若配置了它，会自动注册成 default tenant 下 owner 账号
# 的一条 API token，现有依赖静态 token 的脚本/集成零改动继续可用。全新部署不需要配置——
# 首次启动会自动创建一个 owner 账号(admin@local)和一个系统管理员账号(sysadmin@local)，
# 登录密码默认是固定值 1234.RunForge.5678，登录后应尽快改密或换成下面的覆盖值。
# RUNFORGE_ACCESS_TOKEN=replace-with-a-strong-local-token
# 显式指定这两个引导账号的初始密码(生产/公网环境强烈建议配置，避免使用默认密码)。
# RUNFORGE_BOOTSTRAP_ADMIN_PASSWORD=
# RUNFORGE_BOOTSTRAP_SYSADMIN_PASSWORD=

# 文件分享签名密钥；不填时会复用 RUNFORGE_ACCESS_TOKEN，建议生产/公网环境单独配置。
RUNFORGE_SHARE_SECRET=replace-with-a-different-share-secret

# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/runforge

# LLM 供应商、协议、模型和 API Key 在服务启动后通过系统管理页面按 tenant 保存。

# Agent 循环硬兜底:长任务主要由完成、取消或上下文预算结束;这里只防失控循环。
AGENT_HARD_STEP_CAP=1000

# ---- Tool sandbox defaults ----
# These env values are startup defaults / fallback values. Runtime settings are
# stored in app_settings and can be edited in /sys-admin under Shell / 沙箱.
# This is a general-purpose OS agent, so confinement is opt-in by default.
#   off      (default) only the always-on resource guards and output cap apply
#   enforce  path confinement, shell gating, network switch
TOOL_SANDBOX=off
# Shell process backend in enforce mode:
#   auto   Linux + usable bwrap -> bwrap, otherwise host execution with warning
#   none   host execution
#   bwrap  require bubblewrap; fail if unavailable
TOOL_SANDBOX_BACKEND=auto
# Filesystem tools are confined under this root in enforce mode (default: repo root).
# TOOL_WORKSPACE_ROOT=/path/to/workspace
# 用户跨会话文件目录；容器内固定使用 /u，非容器开发可指定可写绝对路径。
# RUNFORGE_USER_FILES_ROOT=/u
# 原生工具默认注册，不通过环境变量或系统设置做 allow/deny；Skill/MCP 使用 run 级激活。
# Shell: disable entirely, or add blocked command patterns (regex; comma/newline separated).
# 黑名单仅防误操作；容器 PATH 中已安装的命令默认可用，文件边界由 bwrap 维护。
# SHELL_ENABLED=true
# SHELL_DENY=rm\s+-rf\s+/, Format-Volume
# Network switch for shell/web tools in enforce mode:
#   disabled  block network
#   enabled   allow network without domain/IP restrictions
TOOL_NETWORK=disabled
# 单条工具结果硬上限(字符),始终生效。
TOOL_MAX_OUTPUT=40000

# ---- File preview ----
# Office 预览转换服务地址。doc/docx/ppt/pptx/xls/xlsx 等文件会先转成 PDF,再由前端渲染。
# 同 compose 网络内建议用服务名,例如 http://runforge-preview-converter:3000。
# 转换容器需要按部署环境挂载字体目录，避免 Office 文件因缺字体产生版式偏移。
# OFFICE_PREVIEW_CONVERTER_URL=http://127.0.0.1:3002
# OFFICE_PREVIEW_TIMEOUT_MS=180000
# 字体或转换服务镜像变更后可递增该值，让旧 PDF 预览缓存自动失效。
# OFFICE_PREVIEW_CACHE_VERSION=1

# ---- Audio transcription ----
# OpenAI 兼容的音频转写服务地址，填写 API 根地址（例如 http://speaches:8000/v1）。
# 设置后 file_read 可把音频转成带时间戳的文字；密钥可留空用于内网服务。
# RUNFORGE_TRANSCRIPTION_BASE_URL=http://speaches:8000/v1
# RUNFORGE_TRANSCRIPTION_API_KEY=
# RUNFORGE_TRANSCRIPTION_MODEL=Systran/faster-whisper-large-v3
# 可选语言代码，例如 zh 或 en。
# RUNFORGE_TRANSCRIPTION_LANGUAGE=zh

# ---- Observability (Phase 4, OpenTelemetry GenAI) ----
# Off by default (zero overhead). When on, emits invoke_agent → chat →
# execute_tool spans with token usage and tool I/O.
OTEL_ENABLED=false
# OTLP HTTP endpoint of a trace backend (Jaeger/Langfuse/Laminar). With the
# bundled debug profile: docker compose --profile debug up  → http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Also print spans to stdout (handy without a backend):
# OTEL_CONSOLE=true
# OTEL_SERVICE_NAME=runforge

# Provider 每次真实 HTTP attempt 另写一行本地 JSONL，固定保留最近 7 个自然日。
# 请求头不会写入；默认目录为仓库 logs/provider-traces，可按部署挂载位置覆盖。
# RUNFORGE_PROVIDER_TRACE_DIR=/var/log/runforge/provider-traces

# ---- Tenant 业务插件 ----
# 每个根目录按 <root>/<tenantId>/<plugin>/ 放置调用方交付的业务插件目录。
# 多个根目录用逗号或换行分隔；第一个目录同时用于管理页 ZIP/TGZ 手动导入，必须可写。
# 通过部署流水线新增或替换目录后，在租户或系统管理页显式重新加载。
# RUNFORGE_BUSINESS_PLUGIN_ROOTS=/srv/runforge/business-plugins
