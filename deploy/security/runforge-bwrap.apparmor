abi <abi/4.0>,
#include <tunables/global>

# RunForge 本身运行在 Docker 容器中；本配置保留 Docker 默认的主要宿主保护，
# 只允许无特权 bwrap 在新的 user namespace 内建立会话文件系统。
profile runforge-bwrap flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  userns,
  mount,
  umount,
  pivot_root,

  # 宿主运行时需要停止和管理容器进程。
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=runforge-bwrap,

  # 同一个容器内的进程检查仍受 PID namespace 隔离。
  ptrace (trace,read,tracedby,readby) peer=runforge-bwrap,

  # 保留 Docker 默认 profile 的宿主敏感路径限制。
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
